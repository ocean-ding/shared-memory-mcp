# Optional: use an explicit absolute path for this user's private memory.
# The default is ~/.shared-memory-mcp/memory.
MDCG_ROOT=/absolute/path/to/private/memory
MDCG_AUX_ROOT=/absolute/path/to/private/memory-runtime/aux
MDCG_STATE_ROOT=/absolute/path/to/private/memory-runtime/state
MDCG_DATA_ROOT=/absolute/path/to/private/memory-runtime/data
MDCG_ACTOR=friend
MDCG_MCP_SURFACE=kernel
